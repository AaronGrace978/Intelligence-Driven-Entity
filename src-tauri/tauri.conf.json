{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Entity",
  "version": "5.2.0",
  "identifier": "dev.intelligencedrivenentity.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "THE ENTITY",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 480,
        "backgroundColor": "#020806"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
